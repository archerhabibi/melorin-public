APP_NAME="ملورین"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://yourdomain.example

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=melorin
DB_USERNAME=melorin
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

# اگر Redis نصب/فعال است، این سه خط را باز کنید:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ===== ربات اصلی تلگرام =====
# توکن را از BotFather بگیرید — هرگز این فایل پرشده را commit نکنید،
# فقط همین .env.example خالی باید در Git باشد.
TELEGRAM_MAIN_BOT_TOKEN=
TELEGRAM_MAIN_BOT_USERNAME=

# باید یک رشته‌ی تصادفی و طولانی باشد (مثلاً: php artisan tinker --execute="echo Str::random(40);")
TELEGRAM_WEBHOOK_SECRET=

# شناسه‌های عددی تلگرام (نه username) ادمین‌های مجاز، با کاما جدا
TELEGRAM_ADMIN_IDS=

# اختیاری — فقط اگر تست اکانت را فعال کردید (سند 08، بند 1)
TELEGRAM_TRIAL_PRODUCT_ID=

# ===== سوپر ادمین اولیه‌ی پنل مدیریت (اختیاری) =====
# اگر ADMIN_EMAIL و ADMIN_PASSWORD اینجا مقداردهی شوند، دستور
# «php artisan db:seed» (از طریق AdminSeeder) یک سوپرادمین با این
# مشخصات می‌سازد — فقط اگر از قبل ادمینی با همین ایمیل وجود نداشته
# باشد. مناسب برای محیط توسعه/لوکال (مثل Laragon روی ویندوز) که
# اجرای install.sh تعاملیِ سرور ممکن نیست. روی سرور تولید همچنان
# install.sh با پرامپت تعاملی توصیه می‌شود.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@melorin.local
ADMIN_PASSWORD=

MAIL_MAILER=log

# زرین‌پال: true = sandbox.zarinpal.com (فقط staging). مقدار settings.sandbox هر روش پرداخت، اولویت دارد.
ZARINPAL_SANDBOX=false
# ZARINPAL_CALLBACK_URL=  (پیش‌فرض: APP_URL/payment/zarinpal/callback)
