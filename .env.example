APP_NAME="ملورین"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://yourdomain.example

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=melorin
DB_USERNAME=melorin
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
# فاز ۴ (شکاف C8): با config/session.php هم‌راستا شد (پیش‌فرض کد = database).
# Production باید database یا redis باشد، نه file.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production (HTTPS): الزاماً true — Cookie فقط روی HTTPS ارسال می‌شود.
SESSION_SECURE_COOKIE=true

# پراکسی‌های مورد اعتماد (با ویرگول). پیش‌فرض: فقط لوپ‌بک (Nginx/cloudflared روی همین سرور).
# برای پراکسی روی سرور دیگر IP آن را بنویسید؛ هرگز '*' را روی سرور مستقیماً در اینترنت نگذارید.
TRUSTED_PROXIES=127.0.0.1,::1

# اگر Redis نصب/فعال است، این سه خط را باز کنید:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ===== ربات اصلی تلگرام =====
# توکن را از BotFather بگیرید — هرگز این فایل پرشده را commit نکنید،
# فقط همین .env.example خالی باید در Git باشد.
TELEGRAM_MAIN_BOT_TOKEN=
TELEGRAM_MAIN_BOT_USERNAME=

# باید یک رشته‌ی تصادفی و طولانی باشد (مثلاً: php artisan tinker --execute="echo Str::random(40);")
TELEGRAM_WEBHOOK_SECRET=

# شناسه‌های عددی تلگرام (نه username) ادمین‌های مجاز، با کاما جدا
TELEGRAM_ADMIN_IDS=

# اختیاری — فقط اگر تست اکانت را فعال کردید (سند 08، بند 1)
TELEGRAM_TRIAL_PRODUCT_ID=

# ===== سوپر ادمین اولیه‌ی پنل مدیریت (اختیاری) =====
# اگر ADMIN_EMAIL و ADMIN_PASSWORD اینجا مقداردهی شوند، دستور
# «php artisan db:seed» (از طریق AdminSeeder) یک سوپرادمین با این
# مشخصات می‌سازد — فقط اگر از قبل ادمینی با همین ایمیل وجود نداشته
# باشد. مناسب برای محیط توسعه/لوکال (مثل Laragon روی ویندوز) که
# اجرای install.sh تعاملیِ سرور ممکن نیست. روی سرور تولید همچنان
# install.sh با پرامپت تعاملی توصیه می‌شود.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@melorin.local
ADMIN_PASSWORD=

# ⚠️ Email Verification (Master G11): با MAIL_MAILER=log لینک تأیید فقط در لاگ
# نوشته می‌شود و کاربر هرگز Email نمی‌گیرد ⇒ خرید/شارژ سایت برای ثبت‌نام‌های
# جدید مسدود می‌ماند. در Production حتماً SMTP واقعی تنظیم کنید:
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
MAIL_MAILER=log

# زرین‌پال: true = sandbox.zarinpal.com (فقط staging). مقدار settings.sandbox هر روش پرداخت، اولویت دارد.
ZARINPAL_SANDBOX=false
# ZARINPAL_CALLBACK_URL=  (پیش‌فرض: APP_URL/payment/zarinpal/callback)

# ===== ارز سیستم (فاز ۵) — قبل از اولین Migration انتخاب شود، بعداً تغییر نده =====
# تومان: CODE=IRT LABEL=تومان DECIMALS=0 | دلار: CODE=USD LABEL=$ DECIMALS=2 (POSITION=before یا after)
MELORIN_CURRENCY_CODE=IRT
MELORIN_CURRENCY_LABEL=تومان
MELORIN_CURRENCY_DECIMALS=0
MELORIN_CURRENCY_POSITION=after
# حداقل شارژ و دکمه‌های پیشنهادی (به «واحد اصلی ارز»، مثلاً برای دلار: 5 و 10,25,50)
MELORIN_MIN_TOPUP=10000
MELORIN_MIN_SUPPLY_TOPUP=100000
MELORIN_TOPUP_PRESETS=200000,500000,1000000
MELORIN_SUPPLY_TOPUP_PRESETS=1000000,5000000
# فقط اگر Migration به‌خاطر مقدار اعشاری متوقف شد و گرد کردن Half-Up را می‌پذیرید
MELORIN_MONEY_ALLOW_ROUNDING=false

# ===== Google Sign-In (B2.1) — اختیاری؛ بدون این دو کلید دکمه‌ی Google نمایش داده نمی‌شود =====
# Redirect URI در Google Cloud Console باید دقیقاً این باشد: APP_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=  (پیش‌فرض: APP_URL/auth/google/callback)
# true = اگر User محلی با همان Email «تأییدشده» هست، Google به همان وصل شود
GOOGLE_AUTO_LINK_VERIFIED_EMAIL=true
